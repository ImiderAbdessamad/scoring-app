MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wafabail-dossiers
MINIO_SECURE=false
DOSSIERS_STORE_PATH=./data/dossiers.json

# Sans Docker (défaut) : fichiers sur disque, Kafka / MinIO off
STORAGE_BACKEND=local
FILES_DIR=./data/files
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_DOSSIERS=wafabail.dossiers.created
KAFKA_TOPIC_SCORING=wafabail.scoring.events

# Moteur d'extraction (identique RCC v10)
OLLAMA_URL=https://ollama-lnhh4y-11434.svc-usw2.nicegpu.com
RCC_OLLAMA_URL=https://ollama-lnhh4y-11434.svc-usw2.nicegpu.com
RCC_VISION_MODEL=hf.co/unsloth/GLM-4.6V-Flash-GGUF:Q4_K_M
RCC_OCR_MODEL=glm-ocr:q8_0
RCC_VERIFY_MODEL=qwen3-vl:30b
RCC_MAPPER_MODEL=qwen3.5:9b
RCC_COPILOT_MODEL=qwen3.5:9b
RCC_ADJUDICATOR_MODEL=gemma4:latest
RCC_USE_GLM_VERIFICATION=true
RCC_USE_REASONING_MAPPER=true
RCC_USE_ADJUDICATOR=true
RCC_REQUEST_TIMEOUT_SECONDS=600
RCC_KEEP_ALIVE=20m
RCC_RENDER_DPI=220
RCC_EXTRACT_MAX_SIDE=2400
RCC_MAX_PAGES=60
ANALYSE_JOB_TTL_MINUTES=180

# API partenaire PVC (en-tête X-API-Key)
PVC_API_KEY=wfb_pvc_8f2c1a9d4e6b70c3a5d18e4f9b2c7a61

# OCR liasses scannées (V6). Sous Windows, tesseract.exe n'est souvent pas dans le PATH.
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
