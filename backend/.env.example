DATABASE_URL=sqlite+aiosqlite:///./data/wafabail.db
KAFKA_ENABLED=false
JOB_DISPATCHER=local
LOCAL_JOB_CONCURRENCY=1
MAX_UPLOAD_SIZE_MB=25
SCORING_POLICY_VERSION=WFB-CREDIT-V1

SECTOR_DATA_ENABLED=true
SECTOR_PROVIDER=hcp_open_data
SECTOR_DATA_PROVIDER=hcp_ckan
SECTOR_AUTO_REFRESH=true
SECTOR_DATA_AUTO_SYNC=true
SECTOR_METADATA_TTL_HOURS=6
SECTOR_REFRESH_INTERVAL_HOURS=24
SECTOR_DATA_REFRESH_HOURS=24
SECTOR_ANALYSIS_AFFECTS_SCORING=false
DATA_GOV_MA_CKAN_BASE=https://data.gov.ma/data/api/3/action
HCP_CKAN_BASE_URL=https://data.gov.ma/data/api/3/action
SECTOR_DATA_REQUEST_TIMEOUT_SECONDS=30
SECTOR_DATA_MAX_RETRIES=3
SECTOR_DATA_STORE_RAW_FILES=true
SECTOR_DATA_PROVIDER=hcp_ckan
HCP_CKAN_BASE_URL=https://data.gov.ma/data/api/3/action

MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME
MINIO_BUCKET=wafabail-dossiers
MINIO_SECURE=false

STORAGE_BACKEND=local
FILES_DIR=./data/files
DOSSIERS_STORE_PATH=./data/dossiers.json

KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_DOSSIERS=wafabail.dossiers.created
KAFKA_TOPIC_SCORING=wafabail.scoring.events

OLLAMA_URL=
RCC_OLLAMA_URL=
PVC_API_KEY=
TESSERACT_CMD=

# Authentification Keycloak (realm RCC)
AUTH_ENABLED=true
KEYCLOAK_URL=https://keycloak.app-dev.wafabail.ma
KEYCLOAK_REALM=rcc
KEYCLOAK_CLIENT_ID=rcc-wb
KEYCLOAK_REQUIRED_ROLE=RCC_USER
# Vide = <KEYCLOAK_URL>/realms/<realm>/protocol/openid-connect/certs.
# Dans Rancher : http://keycloak.keycloak-dev.svc.cluster.local:8080/realms/rcc/protocol/openid-connect/certs
KEYCLOAK_JWKS_URL=
# Vide = certs/wafabail-root-ca.pem (CA wafabail-SRV-DCPRIMARY-CA-1, livrée avec le projet)
KEYCLOAK_CA_BUNDLE=
